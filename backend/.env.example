# ---------------------------------------------------------------------------
# AI Workout Tracker – Backend Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Datenbank ------------------------------------------------------------
# Bei Nutzung von docker-compose bleibt dieser Wert unverändert.
DATABASE_URL=postgresql://gymapp:gymapp@localhost:5432/gymapp?schema=public

# --- Authentifizierung ----------------------------------------------------
# Zufälliger Wert, mind. 16 Zeichen. Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-hier-ein-langes-zufaelliges-secret-eintragen
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Registrierung offen lassen? Für eine private Instanz nach dem ersten
# Anlegen des Accounts auf false setzen.
ALLOW_REGISTRATION=true

# --- Netzwerk / Schutz ----------------------------------------------------
# Kommaseparierte Origins oder * für alle (nur Entwicklung).
CORS_ORIGIN=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Telegram -------------------------------------------------------------
# Token von @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
# polling funktioniert überall (auch lokal hinter NAT).
# webhook benötigt eine öffentlich erreichbare HTTPS-URL.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Optionale harte Whitelist von Telegram-User-IDs, kommasepariert.
# Leer lassen = jeder darf sich per /link mit einem gültigen Code verbinden.
TELEGRAM_ALLOWED_USER_IDS=

# --- KI-Provider ----------------------------------------------------------
# Ohne OPENAI_API_KEY läuft das System weiter: Textnachrichten werden vom
# regelbasierten Parser verarbeitet, Sprachnachrichten sind dann deaktiviert.
# Anthropic (Claude) – wertet die Spracheingabe aus
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# Privater Einzelnutzer-Modus: kein Login, kein Token
SINGLE_USER_MODE=true
SINGLE_USER_NAME=Athlet

OPENAI_API_KEY=
# Optionale abweichende Basis-URL (z. B. Azure OpenAI oder ein lokaler Proxy).
OPENAI_BASE_URL=

# Speech-to-Text: openai | none
STT_PROVIDER=openai
STT_MODEL=whisper-1

# Workout-Parser: openai | heuristic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Schwellwerte für das Bestätigungssystem
AI_AUTOSAVE_THRESHOLD=0.85
AI_CONFIRM_THRESHOLD=0.5

# --- Lokalisierung --------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Berlin
DEFAULT_LOCALE=de
