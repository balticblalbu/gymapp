<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Klartext-HTTP ist erlaubt, weil der Update-Server im Heimnetz per HTTP
      läuft (ein lokales HTTPS-Zertifikat wäre hier unverhältnismäßig).
      Die Anfragen an Claude gehen unabhängig davon immer über HTTPS – die
      Adresse ist im Code fest verdrahtet und nicht konfigurierbar.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
